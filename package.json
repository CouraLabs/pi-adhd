{
  "name": "@couralabs/pi-adhd",
  "version": "0.10.0",
  "description": "A collection of pi extensions: tools, commands, and lifecycle hooks for the pi coding agent, shaped for ADHD-readable output",
  "keywords": [
    "pi-package",
    "pi-adhd"
  ],
  "type": "module",
  "license": "MIT",
  "files": [
    "extensions",
    "shared",
    "themes",
    "demo.png",
    "CHANGELOG.md",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!extensions/tools/session-dashboard/server/tests",
    "!extensions/tools/session-dashboard/server/fixtures"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run"
  },
  "pi": {
    "extensions": [
      "extensions/index.ts",
      "!**/*.test.ts"
    ],
    "themes": [
      "themes/*.json"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "typebox": "^1.4.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
