{
  "name": "@couralabs/pi-adhd",
  "version": "0.6.0",
  "description": "A collection of pi extensions: tools, commands, and lifecycle hooks for the pi coding agent, shaped for ADHD-readable output",
  "keywords": [
    "pi-package",
    "pi-adhd"
  ],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run"
  },
  "pi": {
    "extensions": [
      "extensions/index.ts",
      "!**/*.test.ts"
    ],
    "themes": [
      "themes/*.json"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
