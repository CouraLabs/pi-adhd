{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ES2024.Promise"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["extensions/**/*.ts", "shared/**/*.ts"],
  "exclude": ["extensions/tools/session-dashboard"]
}
